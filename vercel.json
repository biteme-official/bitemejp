{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/slack-report",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/instagram-follower-cron",
      "schedule": "0 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: data:; font-src 'self' https: data:; connect-src 'self' https://bitemejp-admin.vercel.app https://www.facebook.com https://connect.facebook.net https://api.line.me https://access.line.me https://page.line.me https://www.google-analytics.com https://www.googletagmanager.com https://zipcloud.ibsnet.co.jp; frame-src https://www.facebook.com; object-src 'none'; base-uri 'self';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/kr-reviews.ts": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/api/shopify", "destination": "/api/shopify" },
    { "source": "/api/line-callback", "destination": "/api/line-callback" },
    { "source": "/api/wishlist", "destination": "/api/wishlist" },
    { "source": "/api/customer-orders", "destination": "/api/customer-orders" },
    { "source": "/api/refresh-customer-token", "destination": "/api/refresh-customer-token" },
    { "source": "/api/instagram-reels", "destination": "/api/instagram-reels" },
    { "source": "/api/kr-reviews", "destination": "/api/kr-reviews" },
    { "source": "/api/shopify-purchase-webhook", "destination": "/api/shopify-purchase-webhook" },
    { "source": "/api/product-feed", "destination": "/api/product-feed" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
